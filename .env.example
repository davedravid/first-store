# Copy this file to .env.local for local work and fill in real values.
# On Vercel, add the same names under Project > Settings > Environment Variables.
# Never commit real values.

# LLM providers (free tiers)
# Google Gemini API key, from Google AI Studio
GOOGLE_GENERATIVE_AI_API_KEY=
# Groq API key, from console.groq.com (app runs on the other provider alone if one key is empty)
GROQ_API_KEY=

# Which provider goes first, and which one takes over on timeout / 429 / failed validation
# Values: gemini | groq
LLM_PRIMARY=
LLM_FALLBACK=

# Gemini models
# Full storefront generation
MODEL_GENERATE=
# Single-block regenerate (lighter, faster)
MODEL_REGEN=
# Groq model (must support json_schema structured outputs)
GROQ_MODEL=

# Upstash Redis (storage, rate limits, counters)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Rate limits
# Generations allowed per IP per window
RATE_LIMIT_GENERATE_PER_IP=
# Window length, e.g. "1 h" or "10 m"
RATE_LIMIT_WINDOW=
# "I want this" submissions allowed per IP per window
RATE_LIMIT_WANT_PER_IP=

# Global cap on LLM generations per day, across all users. Keep low: free quotas are small.
DAILY_CAP=

# Max characters accepted in the description box
MAX_INPUT_CHARS=
